POSTGRES_PASSWORD=change-me-to-a-strong-password
PHOENIX_APP_PASSWORD=change-me-to-a-strong-password
PAYMENT_APP_PASSWORD=change-me-to-a-strong-password

# Agent LLM endpoint (OpenAI-compatible). Read by phoenix/graph/llm_client.py.
LLM_BASE_URL=https://llm.example.invalid/v1
LLM_API_KEY=change-me-llm-api-key
LLM_MODEL=change-me-model-name

# Curvet credentials. Nothing in this tree reads them yet. Placeholders only.
CURVET_APP_KEY=change-me-curvet-app-key
CURVET_APP_SECRET=change-me-curvet-app-secret

# Approvals. The API refuses every decision while the token is empty.
# PHOENIX_APPROVERS is a comma-separated list of approver identities.
PHOENIX_APPROVAL_TOKEN=change-me-long-random-approval-token
PHOENIX_APPROVERS=approver-name
PHOENIX_EXECUTION_POLICY=guarded

# Slack approvals (optional). Start the bridge with:
#   docker compose --profile slack up -d slack-bridge
# SLACK_APP_TOKEN starts xapp-, SLACK_BOT_TOKEN starts xoxb-. PHOENIX_SLACK_CHANNEL is a
# channel ID such as C0123456789, not a name. PHOENIX_SLACK_APPROVERS maps Slack user IDs
# to approver names, comma separated (U012ABCDEF=alice,U034DEFGHI=bob); every name must
# also be in PHOENIX_APPROVERS. SLACK_BRIDGE_PASSWORD is the database password of the
# bridge's own role.
SLACK_APP_TOKEN=change-me-slack-app-token
SLACK_BOT_TOKEN=change-me-slack-bot-token
PHOENIX_SLACK_CHANNEL=change-me-channel-id
PHOENIX_SLACK_APPROVERS=change-me-U012ABCDEF=approver-name
PHOENIX_DASHBOARD_URL=http://localhost:5000
SLACK_BRIDGE_PASSWORD=change-me-slack-bridge-password
